{
  "name": "@xyb-community/glioblastoma-workbench",
  "version": "0.1.5",
  "description": "小星宝 StarPal：面向胶质母细胞瘤患者与照护者的本机病程资料、分子档案、治疗历程、指标趋势与医患沟通工作台",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./layout": "./lib/layout.js",
    "./version": "./lib/version.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "files": [
    "dsh",
    "lib",
    "public",
    "schema",
    "demo/build-demo-data.mjs",
    "assets",
    "cordis.patch.yml",
    "VERSION",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build:version": "STARPAL_CHANNEL=beta node scripts/build-version.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:demo": "node --disable-warning=ExperimentalWarning demo/build-demo-data.mjs",
    "probe:primer": "node scripts/probe-disease-primer.mjs",
    "check": "STARPAL_CHANNEL=beta node scripts/build-version.mjs --check && node scripts/build-client.mjs --check && node scripts/check-syntax.mjs && node scripts/check-schema.mjs && node scripts/check-wording.mjs && node --disable-warning=ExperimentalWarning scripts/check-demo-columns.mjs && node --disable-warning=ExperimentalWarning --test test/*.test.mjs && node scripts/check-version.mjs && node scripts/check-workbench-package.mjs .",
    "check:hvt": "node --disable-warning=ExperimentalWarning scripts/check-hvt.mjs",
    "probe": "node --disable-warning=ExperimentalWarning scripts/probe-headless.mjs",
    "probe:client": "node scripts/probe-client-session.mjs",
    "probe:resp": "node --disable-warning=ExperimentalWarning scripts/probe-responsive.mjs",
    "pack:check": "npm pack --dry-run",
    "start": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/glioblastoma-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "UNLICENSED"
}
